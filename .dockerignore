# Never include generated caches, local trials, secrets or archives.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.pytest_tmp/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.zip
**/*.7z
**/*.rar
**/*.tar
**/*.tar.gz
reports/quick_run/
reports/quick_eval/
reports/local_eval/
reports/docker_eval/
